generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  OWNER
  STAFF
}

// Tables
model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  price            Int
  comparePrice     Int?
  sku              String?
  status           ProductStatus    @default(ACTIVE)
  isTrending       Boolean          @default(false)
  trendingOrder    Int              @default(0)
  fabric           String?
  fit              String?
  care             String?
  sizeChartJson    Json?
  tagsJson         Json?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]

  @@index([slug])
  @@index([status, isTrending, trendingOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String
  color         String
  colorHex      String?
  sku           String?
  stock         Int      @default(0)
  priceOverride Int?

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SiteSetting {
  id                  String   @id @default(cuid())
  featuredProductId   String?
  announcementText    String?
  freeDeliveryMin     Int      @default(1999)
  contactPhone        String?
  contactEmail        String?
  whatsapp            String?
  address             String?
  socialLinks         Json?
  deliveryCharges     Json?
  heroTagline         String?
  heroBackgroundWord  String?  @default("GENTS HOOD")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  addresses Address[]

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  fullName    String
  phone       String
  district    String
  area        String
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id               String               @id @default(cuid())
  orderNo          String               @unique
  customerId       String?
  status           OrderStatus          @default(PENDING)
  paymentMethod    PaymentMethod        @default(COD)
  paymentStatus    PaymentStatus        @default(UNPAID)
  subtotal         Int
  deliveryCharge   Int
  discount         Int                  @default(0)
  total            Int
  shippingName     String
  shippingPhone    String
  shippingDistrict String
  shippingArea     String
  shippingAddress  String
  note             String?
  idempotencyKey   String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  customer         Customer?            @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]

  @@index([orderNo])
  @@index([shippingPhone])
  @@index([status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  nameSnapshot  String
  sizeSnapshot  String?
  colorSnapshot String?
  priceSnapshot Int
  qty           Int
  imageSnapshot String?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  metaJson  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}
