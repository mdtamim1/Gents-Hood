generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tables
model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  price            Int
  comparePrice     Int?
  sku              String?
  status           String           @default("ACTIVE")
  isTrending       Boolean          @default(false)
  trendingOrder    Int              @default(0)
  fabric           String?
  fit              String?
  care             String?
  sizeChartJson    String?
  tagsJson         String?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]

  @@index([slug])
  @@index([status, isTrending, trendingOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String
  color         String
  colorHex      String?
  sku           String?
  stock         Int      @default(0)
  priceOverride Int?

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SiteSetting {
  id                  String   @id @default(cuid())
  featuredProductId   String?
  announcementText    String?
  freeDeliveryMin     Int      @default(1999)
  contactPhone        String?
  contactEmail        String?
  whatsapp            String?
  address             String?
  socialLinks         String?
  deliveryCharges     String?
  heroTagline         String?
  heroBackgroundWord  String?  @default("GENTS HOOD")
  galleryStripJson    String?
  trendingBannerJson  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  addresses Address[]

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  fullName    String
  phone       String
  district    String
  area        String
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id                String               @id @default(cuid())
  orderNo           String               @unique
  customerId        String?
  status            String               @default("PENDING")
  paymentMethod     String               @default("COD")
  paymentStatus     String               @default("UNPAID")
  subtotal          Int
  deliveryCharge    Int
  discount          Int                  @default(0)
  manualDiscount    Int                  @default(0)
  paidAmount        Int                  @default(0)
  couponCode        String?
  total             Int
  shippingName      String
  shippingPhone     String
  shippingDistrict  String
  shippingThana     String               @default("")
  shippingArea      String
  shippingAddress   String
  note              String?
  shopNote          String?
  courierName       String?
  courierTrackingNo String?
  courierEntryDone  Boolean              @default(false)
  courierEntryAt    DateTime?
  isManualOrder     Boolean              @default(false)
  syncedAt          DateTime?
  assignedToId      String?
  idempotencyKey    String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customer          Customer?            @relation(fields: [customerId], references: [id])
  assignedTo        AdminUser?           @relation("AssignedOrders", fields: [assignedToId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  activityLogs      OrderActivityLog[]

  @@index([orderNo])
  @@index([shippingPhone])
  @@index([status, createdAt])
  @@index([assignedToId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  nameSnapshot  String
  sizeSnapshot  String?
  colorSnapshot String?
  priceSnapshot Int
  qty           Int
  imageSnapshot String?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    String
  note      String?
  adminId   String?
  adminName String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// New: Detailed activity log per order
model OrderActivityLog {
  id         String   @id @default(cuid())
  orderId    String
  adminId    String?
  adminName  String?
  action     String   // CREATED, ASSIGNED, STATUS_CHANGED, EDITED, COURIER_ENTERED, NOTE_ADDED
  oldValue   String?
  newValue   String?
  note       String?
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([adminId])
}

model AdminUser {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String         @default("Admin")
  passwordHash   String
  role           String         @default("STAFF")
  isActive       Boolean        @default(true)
  displayColor   String?        @default("#6366f1")
  permissions    String?        // JSON: { orders, products, customers, settings, analytics }
  lastLoginAt    DateTime?
  lastLogoutAt   DateTime?
  sessionToken   String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  auditLogs      AuditLog[]
  staffSessions  StaffSession[]
  assignedOrders Order[]        @relation("AssignedOrders")

  @@index([email])
  @@index([sessionToken])
}

// Live session tracking
model StaffSession {
  id          String    @id @default(cuid())
  staffId     String
  token       String    @unique
  isActive    Boolean   @default(true)
  ipAddress   String?
  userAgent   String?
  loginAt     DateTime  @default(now())
  logoutAt    DateTime?
  lastSeenAt  DateTime  @default(now())

  staff       AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())

  admin     AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity, entityId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}
